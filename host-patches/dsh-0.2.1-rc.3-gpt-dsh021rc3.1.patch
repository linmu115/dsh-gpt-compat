+import { Writable } from 'node:stream'
+import { Context } from '@deepseek-ai/cordis'
+import { expect, it, vi } from 'vitest'
+import SubprocessRuntime, { type SubprocessHandle, type SubprocessSpawnSpec, type SubprocessOutcome } from '@deepseek-ai/dsh-subprocess'
+import { LocalBashExecutor } from '@deepseek-ai/dsh-bash-local'
+import { PwshLocalExecutor } from '@deepseek-ai/dsh-pwsh-local'
+for (const [name, executor] of [['bash', LocalBashExecutor], ['pwsh', PwshLocalExecutor]] as const) {
+  it(`${name} exposes interactive stdin and joins termination through the subprocess owner`, async () => {
+    let finish!: (outcome: SubprocessOutcome) => void
+    let written = ''; let spawnSpec: SubprocessSpawnSpec | undefined
+    const terminate = vi.fn(() => finish({exitCode:null,signal:'SIGTERM'}))
+    class Fixture extends SubprocessRuntime {
+      override async terminalEnvironment(): Promise<never> { throw new Error('no terminals') }
+      override async resolveExecutable(command:string): Promise<string> {return command}
+      override spawnTerminal(): Promise<never> {throw new Error('no terminals')}
+      override spawn(spec:SubprocessSpawnSpec):SubprocessHandle {
+        spawnSpec=spec
+        const reader={readFrom:()=>({text:'',lossy:false,nextOffset:0})}
+        const done=new Promise<SubprocessOutcome>(resolve=>{finish=resolve})
+        return {stdin:new Writable({write(chunk,_encoding,callback){written+=chunk.toString();callback()}}),stdout:undefined,stderr:undefined,control:undefined,
+          collected:{stdout:reader,stderr:reader},done,terminate,waitForExit:async()=>{await done;return true}}
+      }
+    }
+    const ctx=new Context();new Fixture(ctx)
+    await ctx.plugin(executor)
+    try {
+      expect(()=>ctx.shell.resolve({command:'read',interactive:true,stdin:'batch'})).toThrow()
+      const process=await ctx.shell.execute(ctx.shell.resolve({command:'read',interactive:true,onExpiry:'none'}))
+      expect(spawnSpec?.stdio.stdin).toBe('pipe')
+      await process.writeStdin!('hello');expect(written).toBe('hello')
+      process.closeStdin!();await expect(process.writeStdin!('late')).rejects.toThrow('stdin')
+      process.terminate!();await process.done
+      expect(await process.waitForExit!()).toBe(true);expect(process.status).toBe('killed');expect(terminate).toHaveBeenCalledOnce()
+    } finally {await ctx.fiber.dispose()}
+  })
+}
