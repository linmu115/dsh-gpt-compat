+import { Context } from '@deepseek-ai/cordis'
+import { expect, it } from 'vitest'
+import SystemPrompt from '../src/index.ts'
+
+it('resolves the route and prepares contributions before evaluating providers', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  try {
+    ctx.on('system-prompt/resolve-context', async (_context, next) => ({ ...await next(), route: { provider: 'p', model: 'm' } }))
+    ctx.on('system-prompt/prepare', async context => {
+      expect(Object.isFrozen(context.route)).toBe(true)
+      ctx.systemPrompt.section({ name: 'prepared', order: 0, text: () => context.route!.model! })
+    })
+    const result = await ctx.systemPrompt.assemble()
+    expect(result.sections).toContainEqual({ name: 'prepared', text: 'm' })
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('rejects a replaced scope and an aborted preparation before reading providers', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  try {
+    const remove = ctx.on('system-prompt/resolve-context', async (_context, next) => ({ ...await next(), scope: {} }))
+    await expect(ctx.systemPrompt.assemble()).rejects.toThrow('cannot replace scope')
+    remove()
+    const controller = new AbortController()
+    let read = false
+    ctx.systemPrompt.section({ name: 'unreached', order: 0, text: () => { read = true; return 'no' } })
+    ctx.on('system-prompt/prepare', async () => { controller.abort() })
+    await expect(ctx.systemPrompt.assemble({ signal: controller.signal })).rejects.toThrow()
+    expect(read).toBe(false)
+  } finally { await ctx.fiber.dispose() }
+})
