+import { Session, SessionId, type SessionEvent } from '@deepseek-ai/dsh-session'
+
+it('replays request selections separately from the original surface and restores it on reset', () => {
+  const session = Session.create(SessionId('projection'))
+  const original = createUserMessage({ content: [{ type: 'text', text: 'original' }], source: { kind: 'user' } })
+  const summary = createUserMessage({ content: [{ type: 'text', text: 'summary' }], source: { kind: 'user' } })
+  session.append('user/message', original, { surfaceOp: 'append' })
+  session.append('request/projection', { messages: [summary], adapterContext: { format: 'test', scope: 'origin', input: [] } })
+  const restored = Session.create(SessionId('restored'), JSON.parse(JSON.stringify(session.snapshotEvents())))
+  expect(restored.deriveMessages()).toEqual([original])
+  expect(restored.deriveRequestMessages()).toEqual([summary])
+  expect(restored.requestProjection()?.adapterContext?.scope).toBe('origin')
+  restored.append('request/projection', { messages: null })
+  expect(restored.deriveRequestMessages()).toEqual([original])
+})
