+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	executor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestFixedCodexAccountNeverFallsBack(t *testing.T) {
+	for _, kind := range []string{"execute", "stream", "count"} {
+		t.Run(kind, func(t *testing.T) {
+			m := NewManager(nil, &RoundRobinSelector{}, nil)
+			m.SetRetryConfig(0, 0, 0)
+			first := &Auth{ID: uuid.NewString(), Provider: "codex", Status: StatusActive}
+			other := &Auth{ID: uuid.NewString(), Provider: "codex", Status: StatusActive}
+			for _, auth := range []*Auth{first, other} {
+				auth.EnsureIndex()
+				registry.GetGlobalRegistry().RegisterClient(auth.ID, "codex", []*registry.ModelInfo{{ID: "gpt-fixed-test"}})
+				t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+				if _, err := m.Register(context.Background(), auth); err != nil {
+					t.Fatal(err)
+				}
+			}
+			m.SetConfig(&config.Config{Routing: config.RoutingConfig{CodexAccount: first.Index}})
+			failure := &Error{HTTPStatus: http.StatusTooManyRequests, Message: "quota exhausted"}
+			e := &authFallbackExecutor{id: "codex", executeErrors: map[string]error{first.ID: failure}, streamFirstErrors: map[string]error{first.ID: failure}, countTokenErrors: map[string]error{first.ID: failure}}
+			m.RegisterExecutor(e)
+			request := executor.Request{Model: "gpt-fixed-test"}
+			var err error
+			switch kind {
+			case "execute":
+				_, err = m.Execute(context.Background(), []string{"codex"}, request, executor.Options{})
+			case "stream":
+				var result *executor.StreamResult
+				result, err = m.ExecuteStream(context.Background(), []string{"codex"}, request, executor.Options{})
+				if result != nil {
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							err = chunk.Err
+						}
+						if len(chunk.Payload) > 0 {
+							t.Fatal("unexpected successful payload after quota error")
+						}
+					}
+				}
+			case "count":
+				_, err = m.ExecuteCount(context.Background(), []string{"codex"}, request, executor.Options{})
+			}
+			if err == nil {
+				t.Fatal("exhausted selected account unexpectedly succeeded via fallback")
+			}
+			for _, id := range append(e.executeCalls, e.streamCalls...) {
+				if id != first.ID {
+					t.Fatalf("used standby account %q", id)
+				}
+			}
+		})
+	}
+}
+
+func TestFixedCodexAccountSnapshotAndPause(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	a := &Auth{ID: "fixed-snapshot", Provider: "codex"}
+	a.EnsureIndex()
+	if _, err := m.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	m.SetConfig(&config.Config{Routing: config.RoutingConfig{CodexAccount: a.Index}})
+	metadata := map[string]any{executor.PinnedAuthMetadataKey: "stale-websocket-binding"}
+	opts, err := m.pinCodexAccount([]string{"codex"}, executor.Options{Metadata: metadata})
+	if err != nil || opts.Metadata[executor.PinnedAuthMetadataKey] != a.ID {
+		t.Fatal("selection did not override old session pin", err)
+	}
+	if metadata[executor.PinnedAuthMetadataKey] != "stale-websocket-binding" {
+		t.Fatal("mutated caller metadata")
+	}
+	if _, err := m.pinCodexAccount([]string{"codex"}, executor.Options{Metadata: map[string]any{"expected_codex_account": "old-account"}}); err == nil {
+		t.Fatal("accepted stale prepared account")
+	}
+	for _, selected := range []string{"paused", "missing-account"} {
+		m.SetConfig(&config.Config{Routing: config.RoutingConfig{CodexAccount: selected}})
+		if _, err := m.pinCodexAccount([]string{"codex"}, executor.Options{}); err == nil {
+			t.Fatal("must fail closed")
+		}
+		if _, err := m.pinCodexAccount([]string{"claude"}, executor.Options{}); err != nil {
+			t.Fatal("changed another provider")
+		}
+	}
+	if opts.Metadata[executor.PinnedAuthMetadataKey] != a.ID {
+		t.Fatal("in-flight snapshot changed")
+	}
+}
