@@ -0,0 +1,53 @@
+package management
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// GetCodexAccount returns policy identity only, never authentication material.
+func (h *Handler) GetCodexAccount(c *gin.Context) {
+	h.mu.Lock()
+	selected := h.cfg.Routing.CodexAccount
+	h.mu.Unlock()
+	c.JSON(http.StatusOK, gin.H{"auth_index": selected, "fixed": selected != "", "contract": "codex-fixed-account/v1"})
+}
+
+// PutCodexAccount uses compare-and-swap so stale panels cannot overwrite a
+// newer selection. Pausing retains credentials and forbids automatic fallback.
+func (h *Handler) PutCodexAccount(c *gin.Context) {
+	var body struct {
+		AuthIndex string  `json:"auth_index"`
+		Expected  *string `json:"expected"`
+	}
+	if c.ShouldBindJSON(&body) != nil || body.Expected == nil || strings.TrimSpace(body.AuthIndex) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "auth_index and expected are required"})
+		return
+	}
+	if body.AuthIndex != "paused" {
+		target := h.authByIndex(body.AuthIndex)
+		if target == nil || target.Provider != "codex" {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "selected Codex account does not exist"})
+			return
+		}
+	}
+	h.mu.Lock()
+	old := h.cfg.Routing.CodexAccount
+	if old != *body.Expected {
+		h.mu.Unlock()
+		c.JSON(http.StatusConflict, gin.H{"error": "account selection changed; refresh before retrying"})
+		return
+	}
+	h.cfg.Routing.CodexAccount = body.AuthIndex
+	snapshot, ok := h.saveConfigAndSnapshotLocked(c)
+	if !ok {
+		h.cfg.Routing.CodexAccount = old
+		h.mu.Unlock()
+		return
+	}
+	h.mu.Unlock()
+	h.reloadConfigAfterManagementSave(c.Request.Context(), snapshot)
+	c.JSON(http.StatusOK, gin.H{"status": "ok", "auth_index": body.AuthIndex})
+}
