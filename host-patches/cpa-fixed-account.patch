diff --git a/sdk/cliproxy/auth/codex_account.go b/sdk/cliproxy/auth/codex_account.go
new file mode 100644
index 00000000..cda5449b
--- /dev/null
+++ b/sdk/cliproxy/auth/codex_account.go
@@ -0,0 +1,46 @@
+package auth
+
+import (
+	"strings"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+// pinCodexAccount snapshots the operator's selection once, before retries or
+// home dispatch. Existing pinned-auth execution then excludes every other ID.
+func (m *Manager) pinCodexAccount(providers []string, opts cliproxyexecutor.Options) (cliproxyexecutor.Options, error) {
+	cfg := m.runtimeConfigSnapshot()
+	if cfg == nil {
+		return opts, nil
+	}
+	codex := false
+	for _, provider := range providers {
+		codex = codex || strings.EqualFold(strings.TrimSpace(provider), "codex")
+	}
+	if !codex {
+		return opts, nil
+	}
+	selected := cfg.Routing.CodexAccount
+	if expected, _ := opts.Metadata["expected_codex_account"].(string); expected != "" && expected != selected {
+		return opts, &Error{Code: "codex_account_changed", Message: "Codex account changed after the request was prepared", HTTPStatus: 409}
+	}
+	if selected == "" {
+		return opts, nil
+	}
+	if selected == "paused" || m.HomeEnabled() {
+		return opts, &Error{Code: "codex_account_unavailable", Message: "selected Codex account is paused or unavailable in this runtime"}
+	}
+	for _, account := range m.List() {
+		if account.Provider != "codex" || account.Index != selected || account.Disabled {
+			continue
+		}
+		metadata := make(map[string]any, len(opts.Metadata)+1)
+		for key, value := range opts.Metadata {
+			metadata[key] = value
+		}
+		metadata[cliproxyexecutor.PinnedAuthMetadataKey] = account.ID
+		opts.Metadata = metadata
+		return opts, nil
+	}
+	return opts, &Error{Code: "codex_account_unavailable", Message: "selected Codex account is missing or disabled; automatic account switching is off"}
+}
