@@ -0,0 +1,54 @@
+package management
+
+import (
+	"context"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestCodexAccountSelectionPersistsAndRejectsStale(t *testing.T) {
+	m := coreauth.NewManager(nil, nil, nil)
+	a := &coreauth.Auth{ID: "account-file", Provider: "codex"}
+	a.EnsureIndex()
+	if _, err := m.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte("routing:\n  strategy: round-robin\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := &config.Config{}
+	h := NewHandler(cfg, path, m)
+	h.SetConfigReloadHook(func(_ context.Context, snapshot *config.Config) { m.SetConfig(snapshot) })
+	put := func(body string) int {
+		r := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(r)
+		c.Request = httptest.NewRequest("PUT", "/routing/codex-account", strings.NewReader(body))
+		c.Request.Header.Set("Content-Type", "application/json")
+		h.PutCodexAccount(c)
+		return r.Code
+	}
+	if code := put(`{"auth_index":"` + a.Index + `","expected":""}`); code != 200 {
+		t.Fatalf("select: %d", code)
+	}
+	data, _ := os.ReadFile(path)
+	if !strings.Contains(string(data), a.Index) {
+		t.Fatal("selection not persisted")
+	}
+	if code := put(`{"auth_index":"paused","expected":""}`); code != 409 {
+		t.Fatalf("stale: %d", code)
+	}
+	if cfg.Routing.CodexAccount != a.Index {
+		t.Fatal("stale write overwrote selection")
+	}
+	if code := put(`{"auth_index":"paused","expected":"` + a.Index + `"}`); code != 200 {
+		t.Fatalf("pause: %d", code)
+	}
+}
