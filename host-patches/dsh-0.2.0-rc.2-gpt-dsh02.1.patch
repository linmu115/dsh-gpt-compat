+import { Context } from '@deepseek-ai/cordis'
+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import LocalFileSystem from '../src/index.ts'
+
+it('guards regular-file deletion by version and cancellation without recursive removal', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-remove-file-'))
+  const ctx = new Context()
+  await ctx.plugin(LocalFileSystem, { cwd: root })
+  try {
+    await writeFile(join(root, 'a'), 'before')
+    const target = await ctx.fs.resolve('a')
+    const before = (await ctx.fs.stat(target))!
+    await writeFile(join(root, 'a'), 'changed content')
+    await expect(ctx.fs.removeFile(target, before)).rejects.toMatchObject({ code: 'FS_STALE_VERSION' })
+    const current = (await ctx.fs.stat(target))!
+    await expect(ctx.fs.removeFile(target, current, AbortSignal.abort())).rejects.toThrow()
+    expect(await readFile(join(root, 'a'), 'utf8')).toBe('changed content')
+    await ctx.fs.removeFile(target, current)
+    expect(await ctx.fs.stat(target)).toBeUndefined()
+    await mkdir(join(root, 'dir'))
+    const directory = await ctx.fs.resolve('dir')
+    await expect(ctx.fs.removeFile(directory, (await ctx.fs.stat(directory))!)).rejects.toMatchObject({ code: 'FS_NOT_REGULAR_FILE' })
+  } finally { await ctx.fiber.dispose(); await rm(root, { recursive: true, force: true }) }
+})
