{
  "name": "dsh-gpt-compat",
  "version": "0.6.0-dsh021rc3.1",
  "private": true,
  "type": "module",
  "description": "Session-scoped Codex tools and native Responses transport for DeepSeek Harness",
  "license": "MIT",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./responses": "./lib/responses.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/responses.md",
    "docs/context.md",
    "docs/qualification.md",
    "docs/maintenance.md",
    "docs/accounts.md",
    "docs/dsh02-release.md",
    "docs/maintenance-20261003.md",
    "docs/upgrade-20261003.md",
    "docs/account-ui-20261006.md",
    "docs/relogin-20261006.md",
    "host-patches/dsh-0.2.1-rc.3-gpt-dsh021rc3.1.patch",
    "host-patches/dsh-0.2.1-rc.3-gpt-dsh021rc3.1.manifest.json",
    "host-patches/README.md",
    "host-patches/LICENSE",
    "host-patches/cpa-fixed-account.patch",
    "host-patches/cpa-fixed-account.md",
    "docs/dsh021-release.md",
    "docs/RELEASE-RC3.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run --config vitest.compat02.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "configure": "node scripts/configure-types.mjs",
    "build:host": "node scripts/build-host-candidate.mjs",
    "audit:host": "node scripts/audit-host-candidate.mjs",
    "test:platform": "vitest run --config vitest.platform.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
